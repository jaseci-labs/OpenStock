# Copy to .env and fill in. Every variable is read when the app runs; nothing is fixed at build time.

# --- Required ---------------------------------------------------------------
# Finnhub key (free at finnhub.io). Several free keys, comma-separated, are rotated: each adds 60 requests/min
FINNHUB_API_KEY=
# FINNHUB_API_KEYS=key_one,key_two
# Public URL of the app: sitemap, robots.txt and canonical links
BETTER_AUTH_URL=http://localhost:8000

# --- Where it listens and keeps its data -------------------------------------
# JAC_WEB_LISTEN=127.0.0.1:8000
# Accounts, watchlists, lists and alerts (SQLite files). Default: .jac/data/web in the project
# JAC_WEB_DATA=/var/lib/openstock

# --- Market data ------------------------------------------------------------
# "cached" (default): quotes refresh hourly, shared by everyone. "realtime": every 15 s, with email price alerts.
# NEXT_PUBLIC_OPENSTOCK_DATA_MODE=cached

# Sentiment card on stock pages (Reddit, X, news, Polymarket)
# ADANOS_API_KEY=
# ADANOS_API_BASE_URL=https://api.adanos.org

# Scored news card on stock pages
# ALPHAI_API_KEY=

# --- AI (personalised welcome email and news digest) -----------------------
# Provider: gemini (default), minimax or siray. A configured provider is also used as a fallback.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M3.1-Flash
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# SIRAY_API_KEY=

# --- Email -------------------------------------------------------------------
# Welcome and price-alert emails: Gmail address + app password. Without them, those emails are skipped.
# NODEMAILER_EMAIL=
# NODEMAILER_PASSWORD=
# Password-reset and address-check links are mailed by the accounts plugin over any SMTP server.
# Without JAC_MAIL_HOST, JAC_MAIL_SENDER and JAC_AUTH_ORIGIN, no links are mailed.
# JAC_AUTH_ORIGIN=https://your-domain.com
# JAC_MAIL_HOST=smtp.gmail.com
# JAC_MAIL_SENDER=OpenStock <you@gmail.com>
# JAC_MAIL_USER=you@gmail.com
# SMTP_PASSWORD=
# Kit (ConvertKit): the weekly news digest broadcast and the welcome form
# KIT_API_KEY=
# KIT_API_SECRET=
# KIT_WELCOME_FORM_ID=

# --- Social sign-in -----------------------------------------------------------
# Each provider turns on only when its ID is set. Callbacks: <JAC_AUTH_ORIGIN>/__jac/auth/github and /google
# SSO_GITHUB_CLIENT_ID=
# SSO_GITHUB_CLIENT_SECRET=
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=

# --- Background jobs ----------------------------------------------------------
# The alert checker, weekly digest and inactive-user check run inside the app. Turn them off with:
# JAC_TICKS_OFF=all
